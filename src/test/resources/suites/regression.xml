<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Every sprint's test cases on Android and iOS emulation (default):  ./mvnw test
  Add each new sprint package (sprint2, sprint3, ...) to both <test> blocks.
-->
<!-- time-out: any single test running over 5 minutes is failed, so a hung test cannot freeze the run -->
<suite name="Regression" time-out="300000" configfailurepolicy="continue">

    <test name="Android - Chrome emulation">
        <parameter name="platform" value="ANDROID_CHROME_EMULATION"/>
        <packages>
            <package name="sprint1"/>
        </packages>
    </test>

    <test name="iOS - Safari (WebKit) emulation">
        <parameter name="platform" value="IOS_SAFARI_EMULATION"/>
        <packages>
            <package name="sprint1"/>
        </packages>
    </test>
</suite>
